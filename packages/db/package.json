{
  "name": "@volleyball-monitoring/db",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./generated/client/client.ts",
    "./pothos": "./generated/pothos.ts"
  },
  "scripts": {
    "generate": "prisma generate --config prisma.config.ts",
    "format": "prisma format --config prisma.config.ts",
    "validate": "prisma validate --config prisma.config.ts",
    "migrate": "prisma migrate dev --config prisma.config.ts",
    "seed": "prisma db seed --config prisma.config.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "echo 'Database integration tests begin after the first migration.'"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "dotenv": "^17.2.1",
    "prisma": "^7.9.1",
    "prisma-pothos-types": "^1.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
