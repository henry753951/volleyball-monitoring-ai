generator client {
  provider     = "prisma-client"
  output       = "../generated/client"
  moduleFormat = "esm"
}

generator pothos {
  provider     = "prisma-pothos-types"
  output       = "../generated/pothos.ts"
  clientOutput = "./client"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  OPERATOR
  ANNOTATOR
  COACH
  VIEWER
}

enum MatchStatus {
  PLANNED
  LIVE
  FINISHED
  ARCHIVED
}

enum SetStatus {
  PLANNED
  LIVE
  FINISHED
}

enum RosterPosition {
  UNSPECIFIED
  OH
  MB
  OPP
  S
  L
  DS
}

enum CaptureStatus {
  STARTING
  LIVE
  STOPPING
  FINISHED
  FAILED
}

enum PlaybackWindowMode {
  LIVE
  ARCHIVE
}

enum SourceHealth {
  STARTING
  HEALTHY
  DEGRADED
  OFFLINE
}

enum MediaSourceWorkStatus {
  REQUESTED
  RUNNING
  DRAINING
  STOP_REQUESTED
  COMPLETED
  FAILED
}

enum MediaExtentStatus {
  WRITING
  FINALIZED_LOCAL
  CATALOGED
  ARCHIVE_PENDING
  ARCHIVE_VERIFIED
}

enum CourtSide {
  LEFT
  RIGHT
}

enum TrackCourtSide {
  LEFT
  RIGHT
  UNKNOWN
}

enum MarkerKind {
  SERVICE
  CONTACT
}

enum BallEventKind {
  SERVE
  RECEIVE
  CONTACT
  SPIKE
}

enum BallServeStyle {
  JUMP
  STANDING
}

enum BallEventResult {
  SUCCESS
  FAILURE
}

enum BallEventSemanticSource {
  HUMAN
  SYSTEM_DEFAULT
  AUTOMATIC
  CORRECTION_COPY
}

enum RallyBoundaryKind {
  START
  END
}

enum TimingPrecision {
  FRAME_EXACT
  PTS_EXACT
  ESTIMATED
}

enum ScoreResolutionState {
  PENDING
  RESOLVED
  UNKNOWN
}

enum SubmissionScoreResolution {
  PENDING
  RESOLVED
  UNKNOWN
}

enum AnnotationStatus {
  OPEN
  READY
  SUBMITTED
  VOIDED
}

enum ProcessingStatus {
  IDLE
  CLIP_QUEUED
  CLIPPING
  AI_QUEUED
  AI_PROCESSING
  ARTIFACT_INGESTING
  COMPLETED
  FAILED
  CANCELLED
  SUPERSEDED
}

enum SubmissionStatus {
  ACTIVE
  SUPERSEDED
  CANCELLED
}

enum ScoreLedgerEntryKind {
  POINT_AWARD
  CORRECTION
  CORRECTION_ROLLBACK
}

enum JobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  SUPERSEDED
}

enum ProviderWorkKind {
  ANALYSIS
  REID_FEATURE_EXTRACTION
  REID_ASSOCIATION
  PERSON_POSE_EVIDENCE_REBUILD
  IDENTITY_PREVIEW_GENERATION
}

enum ProviderArtifactDirection {
  INPUT
  OUTPUT
}

enum ReidEvidenceState {
  UNVERIFIED
  CONFIRMED
  REJECTED
  QUARANTINED
}

enum ReidEvidenceRole {
  POSITIVE
  NEGATIVE
}

enum ReidAssociationState {
  RESOLVED
  UNRESOLVED
  NEEDS_REVIEW
}

enum ReidCorrectionDisplayScope {
  CURRENT_CLIP
  FROM_HERE
  WHOLE_MATCH
}

enum ReidFutureEvidenceAction {
  NONE
  CONFIRM_TARGET
  REJECT_SOURCE
  REJECT_SOURCE_AND_CONFIRM_TARGET
  QUARANTINE_SOURCE
}

enum ContactAssociationSource {
  POSE_HAND
  BBOX_ACTION
  BBOX_SPATIAL
  UNRESOLVED
}

enum ArtifactState {
  UPLOADING
  READY
  FAILED
  DELETED
}

enum MediaAssetKind {
  RAW_RECORDING
  DVR_INIT
  DVR_SEGMENT
  SAMPLE_INDEX
  CANONICAL_CLIP
  PREVIEW_CLIP
  TIMING_MANIFEST
  ANALYSIS_DATA
  ANALYSIS_FRAME_CHUNK
  PROVIDER_ARTIFACT
  PERSON_POSE_EVIDENCE
  REID_EVIDENCE
  IDENTITY_PREVIEW
  JERSEY_MONTAGE
  HIGHLIGHT_REEL
}

enum AssociationState {
  RESOLVED_SINGLE
  RESOLVED_MULTIPLE
  AMBIGUOUS
  UNRESOLVED
  NO_PLAYER
}

enum BallObservationState {
  OBSERVED
  INTERPOLATED
  MISSING
}

enum SegmentRenderState {
  COMPLETE
  PARTIAL
  UNAVAILABLE
}

enum SegmentEndpoint {
  START
  END
}

enum IdentitySource {
  MANUAL
  AI
  PROPAGATED
}

enum CallbackKind {
  PROCESSING
  FAILED
  COMPLETED
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

enum AnalysisReviewStatus {
  EDITING
  READY
  APPROVED
}

model User {
  id                           String                         @id @default(uuid()) @db.Uuid
  email                        String                         @unique
  displayName                  String
  createdAt                    DateTime                       @default(now())
  updatedAt                    DateTime                       @updatedAt
  memberships                  MatchMember[]
  deviceSessions               DeviceSession[]
  createdKeyPoints             KeyPoint[]                     @relation("KeyPointCreatedBy")
  updatedKeyPoints             KeyPoint[]                     @relation("KeyPointUpdatedBy")
  annotationOperations         AnnotationOperation[]
  annotationReceipts           AnnotationCommandReceipt[]
  submittedRevisions           RallySubmission[]              @relation("SubmissionSubmittedBy")
  identityAssignments          TrackIdentityAssignment[]
  completedIdentityMappings    AnalysisRun[]                  @relation("IdentityMappingCompletedBy")
  approvedAnalysisReviews      AnalysisRun[]                  @relation("AnalysisReviewApprovedBy")
  playbackWindows              PlaybackWindow[]               @relation("PlaybackWindowCreatedBy")
  reidMemberships              ReidEvidenceMembership[]       @relation("ReidMembershipCreatedBy")
  reidIdentityCorrections      ReidIdentityCorrection[]       @relation("ReidIdentityCorrectionCreatedBy")
  reidAssignmentRevisions      ReidAssignmentRevision[]       @relation("ReidAssignmentRevisionCreatedBy")
  reidFeatureRebuildRequests   ReidFeatureRebuildRequest[]    @relation("ReidFeatureRebuildRequestedBy")
  reidAssociationRerunRequests ReidAssociationRerunRequest[]  @relation("ReidAssociationRerunRequestedBy")
  reidGidBindingRevisions      ReidGidRosterBindingRevision[] @relation("ReidGidBindingCreatedBy")
  reidJerseySuggestionRuns     ReidJerseySuggestionRun[]      @relation("ReidJerseySuggestionRequestedBy")
  appliedReidJerseySuggestions ReidJerseySuggestion[]         @relation("ReidJerseySuggestionAppliedBy")
  requestedHighlightExports    CoachHighlightExportJob[]      @relation("CoachHighlightRequestedBy")
}

model MatchMember {
  matchId String   @db.Uuid
  userId  String   @db.Uuid
  role    UserRole
  match   Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([matchId, userId])
}

model DeviceSession {
  id           String                     @id @default(uuid()) @db.Uuid
  userId       String                     @db.Uuid
  label        String?
  userAgent    String?
  createdAt    DateTime                   @default(now())
  lastSeenAt   DateTime                   @default(now())
  revokedAt    DateTime?
  user         User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  keyPoints    KeyPoint[]
  operations   AnnotationOperation[]
  receipts     AnnotationCommandReceipt[]
  draftRallies Rally[]                    @relation("RallyDraftOwner")
}

model Match {
  id                      String                         @id @default(uuid()) @db.Uuid
  title                   String
  venue                   String?
  status                  MatchStatus                    @default(PLANNED)
  clipPreRollUs           BigInt                         @default(0)
  clipPostRollUs          BigInt                         @default(0)
  scheduledAt             DateTime?
  deletionRequestedAt     DateTime?
  identityRevision        BigInt                         @default(0)
  createdAt               DateTime                       @default(now())
  updatedAt               DateTime                       @updatedAt
  members                 MatchMember[]
  matchTeams              MatchTeam[]
  sets                    MatchSet[]
  rosterEntries           MatchRosterEntry[]
  captureSessions         CaptureSession[]
  rallies                 Rally[]
  reidPersonClusters      ReidPersonCluster[]
  reidBankSnapshots       ReidBankSnapshot[]
  reidCannotLinks         ReidCannotLink[]
  reidIdentityRepairs     ReidIdentityCorrection[]
  reidAssignmentRevisions ReidAssignmentRevision[]
  reidGidBindingRevisions ReidGidRosterBindingRevision[]
  highlightExports        CoachHighlightExportJob[]

  @@index([deletionRequestedAt])
}

model Team {
  id                   String                   @id @default(uuid()) @db.Uuid
  name                 String
  shortName            String
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  matchTeams           MatchTeam[]
  players              Player[]
  rosterEntries        MatchRosterEntry[]
  leftAssignments      CourtSideAssignment[]    @relation("AssignmentLeftTeam")
  rightAssignments     CourtSideAssignment[]    @relation("AssignmentRightTeam")
  scoringRallies       Rally[]                  @relation("RallyScoringTeam")
  submissionLeftTeams  RallySubmission[]        @relation("SubmissionLeftTeam")
  submissionRightTeams RallySubmission[]        @relation("SubmissionRightTeam")
  submissionWinners    RallySubmission[]        @relation("SubmissionScoringTeam")
  pointAwards          PointAward[]
  wonSets              MatchSet[]               @relation("SetWinningTeam")
  reidPersonClusters   ReidPersonCluster[]
  reidBankSnapshots    ReidBankSnapshot[]
  reidIdentityRepairs  ReidIdentityCorrection[]
}

model MatchTeam {
  matchId String @db.Uuid
  teamId  String @db.Uuid
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team    Team   @relation(fields: [teamId], references: [id], onDelete: Restrict)

  @@id([matchId, teamId])
}

model Player {
  id            String             @id @default(uuid()) @db.Uuid
  teamId        String             @db.Uuid
  name          String
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  team          Team               @relation(fields: [teamId], references: [id], onDelete: Restrict)
  rosterEntries MatchRosterEntry[]
}

model MatchRosterEntry {
  id                       String                         @id @default(uuid()) @db.Uuid
  matchId                  String                         @db.Uuid
  teamId                   String                         @db.Uuid
  playerId                 String?                        @db.Uuid
  jerseyNumber             String
  position                 RosterPosition                 @default(UNSPECIFIED)
  displayNameSnapshot      String?
  active                   Boolean                        @default(true)
  createdAt                DateTime                       @default(now())
  updatedAt                DateTime                       @updatedAt
  match                    Match                          @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team                     Team                           @relation(fields: [teamId], references: [id], onDelete: Restrict)
  player                   Player?                        @relation(fields: [playerId], references: [id], onDelete: SetNull)
  identityAssignments      TrackIdentityAssignment[]
  reidMemberships          ReidEvidenceMembership[]
  reidAssociationDecisions ReidAssociationDecision[]
  reidIdentityRepairs      ReidIdentityCorrection[]
  reidAssignmentRevisions  ReidAssignmentRevision[]
  reidPersonClusters       ReidPersonCluster[]
  reidGidBindingRevisions  ReidGidRosterBindingRevision[]
  reidJerseySuggestions    ReidJerseySuggestion[]
  draftBallEvents          BallEventDraft[]               @relation("DraftBallEventActorRoster")
  submissionBallEvents     RallySubmissionBallEvent[]     @relation("SubmissionBallEventActorRoster")

  @@index([matchId, teamId, jerseyNumber])
}

model MatchSet {
  id              String                @id @default(uuid()) @db.Uuid
  matchId         String                @db.Uuid
  setNumber       Int
  status          SetStatus             @default(PLANNED)
  leftScore       Int                   @default(0)
  rightScore      Int                   @default(0)
  scoreRevision   Int                   @default(0)
  winningTeamId   String?               @db.Uuid
  startedAt       DateTime?
  endedAt         DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  match           Match                 @relation(fields: [matchId], references: [id], onDelete: Cascade)
  winningTeam     Team?                 @relation("SetWinningTeam", fields: [winningTeamId], references: [id], onDelete: Restrict)
  sideAssignments CourtSideAssignment[]
  rallies         Rally[]
  pointAwards     PointAward[]
  scoreLedger     ScoreLedgerEntry[]

  @@unique([matchId, setNumber])
  @@index([matchId, winningTeamId])
}

model CourtSideAssignment {
  id                        String            @id @default(uuid()) @db.Uuid
  setId                     String            @db.Uuid
  effectiveFromRallyOrdinal Int
  effectiveToRallyOrdinal   Int?
  leftTeamId                String            @db.Uuid
  rightTeamId               String            @db.Uuid
  createdAt                 DateTime          @default(now())
  set                       MatchSet          @relation(fields: [setId], references: [id], onDelete: Cascade)
  leftTeam                  Team              @relation("AssignmentLeftTeam", fields: [leftTeamId], references: [id], onDelete: Restrict)
  rightTeam                 Team              @relation("AssignmentRightTeam", fields: [rightTeamId], references: [id], onDelete: Restrict)
  rallies                   Rally[]
  submissions               RallySubmission[]

  @@unique([setId, effectiveFromRallyOrdinal])
}

model CaptureSession {
  id                         String                   @id @default(uuid()) @db.Uuid
  matchId                    String                   @db.Uuid
  sourceKind                 String
  sourceLabel                String?
  sourceConfigSecretRef      String?
  sourceDurationUs           BigInt?
  ingestPath                 String                   @unique
  status                     CaptureStatus            @default(STARTING)
  health                     SourceHealth             @default(STARTING)
  sourceOnline               Boolean                  @default(false)
  sourceObservedAt           DateTime?
  startedAt                  DateTime?
  endedAt                    DateTime?
  completionExpectedSegments Int?
  completionRequestedAt      DateTime?
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  match                      Match                    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  programs                   DvrProgram[]
  epochs                     CaptureEpoch[]
  playbackWindows            PlaybackWindow[]
  sourceWork                 MediaSourceWork?
  ingestFailures             MediaIngestFailure[]
  mediaExtents               MediaExtent[]
  livePresentationAnchors    LivePresentationAnchor[]

  @@index([matchId, createdAt, id])
}

model MediaIngestFailure {
  sourceJobId      String         @id @db.Uuid
  captureSessionId String         @db.Uuid
  code             String
  createdAt        DateTime       @default(now())
  captureSession   CaptureSession @relation(fields: [captureSessionId], references: [id], onDelete: Cascade)

  @@index([captureSessionId])
}

model MediaSourceWork {
  id                  String                @id @default(uuid()) @db.Uuid
  captureSessionId    String                @unique @db.Uuid
  sourceKind          String
  sourceUrl           String?
  importKey           String?
  status              MediaSourceWorkStatus @default(REQUESTED)
  attempts            Int                   @default(0)
  availableAt         DateTime              @default(now())
  leaseOwner          String?
  leaseExpiresAt      DateTime?
  lastHeartbeatAt     DateTime?
  lastErrorCode       String?
  authMetadata        Json?
  segmentBaseAt       DateTime              @default(now())
  resumeSegmentIndex  Int                   @default(0)
  resumeCaptureTimeUs BigInt                @default(0)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  captureSession      CaptureSession        @relation(fields: [captureSessionId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@index([leaseExpiresAt])
}

model CaptureEpoch {
  id                     String                    @id @default(uuid()) @db.Uuid
  captureSessionId       String                    @db.Uuid
  sequenceIndex          Int
  sourceTimeBaseNum      Int
  sourceTimeBaseDen      Int
  sourcePtsOrigin        BigInt
  captureTimeOriginUs    BigInt
  captureFrameOrigin     BigInt
  startedAtCaptureUs     BigInt
  endedAtCaptureUs       BigInt?
  discontinuityReason    String?
  createdAt              DateTime                  @default(now())
  captureSession         CaptureSession            @relation(fields: [captureSessionId], references: [id], onDelete: Cascade)
  segments               DvrSegment[]
  mediaExtents           MediaExtent[]
  keyPoints              KeyPoint[]
  submissionKeyPoints    RallySubmissionKeyPoint[]
  rallyBoundaries        RallyBoundary[]
  submissionBoundaries   RallySubmissionBoundary[]
  livePresentationAnchor LivePresentationAnchor?

  @@unique([captureSessionId, sequenceIndex])
  @@index([captureSessionId, startedAtCaptureUs, endedAtCaptureUs])
}

model LivePresentationAnchor {
  id                  String         @id @default(uuid()) @db.Uuid
  captureSessionId    String         @db.Uuid
  captureEpochId      String?        @unique @db.Uuid
  sequenceIndex       Int
  streamInstanceId    String
  programDateTime     DateTime
  firstMediaSequence  BigInt
  captureTimeOriginUs BigInt?
  observedAt          DateTime
  endedAt             DateTime?
  validatedAt         DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  captureSession      CaptureSession @relation(fields: [captureSessionId], references: [id], onDelete: Cascade)
  captureEpoch        CaptureEpoch?  @relation(fields: [captureEpochId], references: [id], onDelete: SetNull)

  @@unique([captureSessionId, sequenceIndex])
  @@unique([captureSessionId, streamInstanceId, programDateTime])
  @@index([captureSessionId, endedAt, sequenceIndex])
  @@index([captureSessionId, programDateTime])
}

model DvrProgram {
  id               String           @id @default(uuid()) @db.Uuid
  captureSessionId String           @db.Uuid
  status           CaptureStatus    @default(STARTING)
  playlistRevision BigInt           @default(0)
  liveEdgeUs       BigInt           @default(0)
  durationUs       BigInt           @default(0)
  fpsNum           Int
  fpsDen           Int
  timeBaseNum      Int
  timeBaseDen      Int
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  captureSession   CaptureSession   @relation(fields: [captureSessionId], references: [id], onDelete: Cascade)
  segments         DvrSegment[]
  rallies          Rally[]
  playbackWindows  PlaybackWindow[]
  mediaExtents     MediaExtent[]

  @@index([captureSessionId, createdAt, id])
}

model MediaAsset {
  id                      String                       @id @default(uuid()) @db.Uuid
  kind                    MediaAssetKind
  bucket                  String
  objectKey               String
  contentType             String
  byteLength              BigInt?
  sha256                  String?
  internalSchemaVersion   String?
  state                   ArtifactState                @default(UPLOADING)
  createdAt               DateTime                     @default(now())
  readyAt                 DateTime?
  deletedAt               DateTime?
  dvrInitSegments         DvrSegment[]                 @relation("DvrInitAsset")
  dvrMediaSegments        DvrSegment[]                 @relation("DvrMediaAsset")
  dvrSampleIndexSegments  DvrSegment[]                 @relation("DvrSampleIndexAsset")
  clipOutputs             ClipJob[]                    @relation("ClipOutputAsset")
  clipTimingManifests     ClipJob[]                    @relation("ClipTimingAsset")
  analysisDataRaw         AnalysisRun[]                @relation("AnalysisDataRaw")
  analysisArtifacts       AnalysisArtifact[]
  analysisFrameChunks     AnalysisFrameChunk[]
  providerJobArtifacts    ProviderJobArtifact[]
  analysisEvidenceBundles AnalysisEvidenceBundle[]     @relation("AnalysisEvidenceManifestAsset")
  analysisEvidenceCrops   AnalysisEvidenceBundle[]     @relation("AnalysisEvidenceCropSourceAsset")
  personPoseManifests     PersonPoseEvidenceManifest[] @relation("PersonPoseManifestAsset")
  personPoseChunks        PersonPoseEvidenceChunk[]    @relation("PersonPoseChunkAsset")
  reidDescriptorBundles   ReidEvidenceSet[]            @relation("ReidDescriptorBundleAsset")
  reidFeatureResults      ReidEvidenceSet[]            @relation("ReidFeatureResultAsset")
  reidBankManifests       ReidBankSnapshot[]           @relation("ReidBankManifestAsset")
  reidAssociationResults  ReidAssociationRun[]         @relation("ReidAssociationResultAsset")
  reidPreviewAssets       ReidIdentityPreview[]        @relation("ReidPreviewAsset")
  reidJerseyMontages      ReidJerseySuggestion[]       @relation("ReidJerseySuggestionMontageAsset")
  highlightExportOutputs  CoachHighlightExportJob[]    @relation("CoachHighlightOutputAsset")

  @@unique([bucket, objectKey])
  @@index([kind, state, createdAt])
}

model DvrSegment {
  id                     String                  @id @default(uuid()) @db.Uuid
  dvrProgramId           String                  @db.Uuid
  captureEpochId         String                  @db.Uuid
  sequenceNumber         BigInt
  discontinuitySequence  Int                     @default(0)
  captureStartUs         BigInt
  captureEndUs           BigInt
  sourcePtsStart         BigInt?
  sourcePtsEnd           BigInt?
  firstFrameIndex        BigInt?
  frameCount             BigInt
  durationUs             BigInt
  isGap                  Boolean                 @default(false)
  initAssetId            String?                 @db.Uuid
  mediaAssetId           String?                 @db.Uuid
  sampleIndexAssetId     String?                 @db.Uuid
  createdAt              DateTime                @default(now())
  readyAt                DateTime?
  program                DvrProgram              @relation(fields: [dvrProgramId], references: [id], onDelete: Cascade)
  captureEpoch           CaptureEpoch            @relation(fields: [captureEpochId], references: [id], onDelete: Restrict)
  initAsset              MediaAsset?             @relation("DvrInitAsset", fields: [initAssetId], references: [id], onDelete: Restrict)
  mediaAsset             MediaAsset?             @relation("DvrMediaAsset", fields: [mediaAssetId], references: [id], onDelete: Restrict)
  sampleIndexAsset       MediaAsset?             @relation("DvrSampleIndexAsset", fields: [sampleIndexAssetId], references: [id], onDelete: Restrict)
  playbackWindowSegments PlaybackWindowSegment[]
  mediaExtent            MediaExtent?

  @@unique([dvrProgramId, sequenceNumber])
  @@index([dvrProgramId, captureStartUs, captureEndUs])
  @@index([dvrProgramId, captureEndUs, captureStartUs])
}

model MediaExtent {
  id                       String            @id @default(uuid()) @db.Uuid
  captureSessionId         String            @db.Uuid
  dvrProgramId             String            @db.Uuid
  dvrSegmentId             String?           @unique @db.Uuid
  captureEpochId           String?           @db.Uuid
  sequenceNumber           BigInt?
  discontinuitySequence    Int?
  sourceJobId              String?           @unique @db.Uuid
  source                   String
  startUs                  BigInt
  endUs                    BigInt
  sourcePtsStart           BigInt?
  sourcePtsEnd             BigInt?
  firstFrameIndex          BigInt?
  frameCount               BigInt?
  localPath                String?
  bucket                   String?
  objectKey                String?
  mediaSha256              String?
  mediaSchemaVersion       String?
  initBucket               String?
  initObjectKey            String?
  initSha256               String?
  initBytes                BigInt?
  initSchemaVersion        String?
  sampleIndexBucket        String?
  sampleIndexObjectKey     String?
  sampleIndexSha256        String?
  sampleIndexBytes         BigInt?
  sampleIndexSchemaVersion String?
  status                   MediaExtentStatus @default(FINALIZED_LOCAL)
  bytes                    BigInt?
  finalizedAt              DateTime?
  catalogedAt              DateTime?
  archiveVerifiedAt        DateTime?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  captureSession           CaptureSession    @relation(fields: [captureSessionId], references: [id], onDelete: Cascade)
  dvrProgram               DvrProgram        @relation(fields: [dvrProgramId], references: [id], onDelete: Cascade)
  dvrSegment               DvrSegment?       @relation(fields: [dvrSegmentId], references: [id], onDelete: SetNull)
  captureEpoch             CaptureEpoch?     @relation(fields: [captureEpochId], references: [id], onDelete: Restrict)

  @@index([dvrProgramId, startUs, endUs])
  @@index([captureSessionId, startUs, endUs])
  @@index([captureEpochId])
  @@index([dvrProgramId, discontinuitySequence, sequenceNumber])
  @@index([captureSessionId, status, createdAt])
  @@index([status, createdAt, id])
}

model PlaybackWindow {
  id                          String                  @id @default(uuid()) @db.Uuid
  captureSessionId            String                  @db.Uuid
  dvrProgramId                String                  @db.Uuid
  createdByUserId             String                  @db.Uuid
  mode                        PlaybackWindowMode
  mappingVersion              Int                     @default(1)
  timelineVersion             BigInt
  captureStartUs              BigInt
  captureEndUs                BigInt
  presentationOriginCaptureUs BigInt
  targetPlayerMediaTimeUs     BigInt
  expiresAt                   DateTime
  createdAt                   DateTime                @default(now())
  captureSession              CaptureSession          @relation(fields: [captureSessionId], references: [id], onDelete: Cascade)
  dvrProgram                  DvrProgram              @relation(fields: [dvrProgramId], references: [id], onDelete: Restrict)
  createdBy                   User                    @relation("PlaybackWindowCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  segments                    PlaybackWindowSegment[]

  @@index([captureSessionId, expiresAt])
  @@index([expiresAt, id])
  @@index([dvrProgramId, captureStartUs, captureEndUs])
}

model PlaybackWindowSegment {
  id               String         @id @default(uuid()) @db.Uuid
  playbackWindowId String         @db.Uuid
  dvrSegmentId     String         @db.Uuid
  sequenceIndex    Int
  playbackWindow   PlaybackWindow @relation(fields: [playbackWindowId], references: [id], onDelete: Cascade)
  dvrSegment       DvrSegment     @relation(fields: [dvrSegmentId], references: [id], onDelete: Restrict)

  @@unique([playbackWindowId, sequenceIndex])
  @@unique([playbackWindowId, dvrSegmentId])
}

model Rally {
  id                        String                @id @default(uuid()) @db.Uuid
  matchId                   String                @db.Uuid
  setId                     String                @db.Uuid
  dvrProgramId              String                @db.Uuid
  sideAssignmentId          String                @db.Uuid
  sideAssignmentReversed    Boolean               @default(false)
  ordinal                   Int
  displaySetNumber          Int                   @default(1)
  displayOrdinal            Int                   @default(1)
  annotationRevision        BigInt                @default(0)
  annotationStatus          AnnotationStatus      @default(OPEN)
  processingStatus          ProcessingStatus      @default(IDLE)
  scoreResolutionState      ScoreResolutionState  @default(PENDING)
  scoringCourtSide          CourtSide?
  scoringTeamId             String?               @db.Uuid
  leftScoreBefore           Int?
  rightScoreBefore          Int?
  leftScoreAfter            Int?
  rightScoreAfter           Int?
  activeSubmissionId        String?               @unique @db.Uuid
  draftOwnerDeviceSessionId String?               @db.Uuid
  createdAt                 DateTime              @default(now())
