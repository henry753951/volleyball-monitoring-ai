  weight                  Float
  sourceRevision          BigInt
  supersedesMembershipId  String?                  @db.Uuid
  correctionId            String?                  @db.Uuid
  createdByUserId         String?                  @db.Uuid
  createdAt               DateTime                 @default(now())
  personCluster           ReidPersonCluster        @relation(fields: [personClusterId], references: [id], onDelete: Cascade)
  tracklet                ReidTracklet             @relation(fields: [trackletId], references: [id], onDelete: Restrict)
  rosterEntry             MatchRosterEntry?        @relation(fields: [rosterEntryId], references: [id], onDelete: SetNull)
  supersedesMembership    ReidEvidenceMembership?  @relation("ReidMembershipRevision", fields: [supersedesMembershipId], references: [id], onDelete: Restrict)
  supersededByMemberships ReidEvidenceMembership[] @relation("ReidMembershipRevision")
  correction              ReidIdentityCorrection?  @relation(fields: [correctionId], references: [id], onDelete: Restrict)
  createdBy               User?                    @relation("ReidMembershipCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([personClusterId, trackletId, sourceRevision])
  @@index([trackletId, sourceRevision])
  @@index([personClusterId, evidenceState, evidenceRole, sourceRevision])
  @@index([supersedesMembershipId])
}

model ReidCannotLink {
  id              String       @id @default(uuid()) @db.Uuid
  matchId         String       @db.Uuid
  leftTrackletId  String       @db.Uuid
  rightTrackletId String       @db.Uuid
  reason          String
  sourceRevision  BigInt
  createdAt       DateTime     @default(now())
  match           Match        @relation(fields: [matchId], references: [id], onDelete: Cascade)
  leftTracklet    ReidTracklet @relation("ReidCannotLinkLeft", fields: [leftTrackletId], references: [id], onDelete: Cascade)
  rightTracklet   ReidTracklet @relation("ReidCannotLinkRight", fields: [rightTrackletId], references: [id], onDelete: Cascade)

  @@unique([matchId, leftTrackletId, rightTrackletId, sourceRevision])
  @@index([rightTrackletId])
}

model ReidBankSnapshot {
  id                String               @id @default(uuid()) @db.Uuid
  matchId           String               @db.Uuid
  teamId            String               @db.Uuid
  revision          BigInt
  asOfSetNumber     Int
  asOfRallyOrdinal  Int
  schemaVersion     String
  derivationVersion String
  manifestAssetId   String               @db.Uuid
  contentSha256     String
  createdAt         DateTime             @default(now())
  match             Match                @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team              Team                 @relation(fields: [teamId], references: [id], onDelete: Restrict)
  manifestAsset     MediaAsset           @relation("ReidBankManifestAsset", fields: [manifestAssetId], references: [id], onDelete: Restrict)
  associationRuns   ReidAssociationRun[]

  @@unique([matchId, teamId, revision, asOfSetNumber, asOfRallyOrdinal, derivationVersion])
  @@index([matchId, teamId, asOfSetNumber, asOfRallyOrdinal])
}

model ReidAssociationRun {
  id                String                       @id @default(uuid()) @db.Uuid
  evidenceSetId     String                       @db.Uuid
  bankSnapshotId    String                       @db.Uuid
  providerJobId     String                       @unique @db.Uuid
  schemaVersion     String
  status            JobStatus                    @default(QUEUED)
  shadowOnly        Boolean                      @default(true)
  resultAssetId     String?                      @db.Uuid
  contentSha256     String?
  createdAt         DateTime                     @default(now())
  completedAt       DateTime?
  supersededAt      DateTime?
  supersededByRunId String?                      @db.Uuid
  rerunRequestId    String?                      @db.Uuid
  evidenceSet       ReidEvidenceSet              @relation(fields: [evidenceSetId], references: [id], onDelete: Restrict)
  bankSnapshot      ReidBankSnapshot             @relation(fields: [bankSnapshotId], references: [id], onDelete: Restrict)
  providerJob       ProviderJob                  @relation("ReidAssociationProviderJob", fields: [providerJobId], references: [id], onDelete: Restrict)
  resultAsset       MediaAsset?                  @relation("ReidAssociationResultAsset", fields: [resultAssetId], references: [id], onDelete: Restrict)
  decisions         ReidAssociationDecision[]
  supersededByRun   ReidAssociationRun?          @relation("ReidAssociationRunSupersession", fields: [supersededByRunId], references: [id], onDelete: Restrict)
  supersededRuns    ReidAssociationRun[]         @relation("ReidAssociationRunSupersession")
  rerunRequest      ReidAssociationRerunRequest? @relation(fields: [rerunRequestId], references: [id], onDelete: Restrict)

  @@index([evidenceSetId, createdAt])
  @@index([bankSnapshotId])
  @@index([status, shadowOnly, createdAt])
  @@index([evidenceSetId, supersededAt, createdAt])
  @@index([supersededByRunId])
  @@index([rerunRequestId])
}

model ReidAssociationDecision {
  id                      String               @id @default(uuid()) @db.Uuid
  associationRunId        String               @db.Uuid
  trackletId              String               @db.Uuid
  groupKey                String
  decisionAction          String
  newGidGroupKey          String?
  associationState        ReidAssociationState
  selectedPersonClusterId String?              @db.Uuid
  selectedRosterEntryId   String?              @db.Uuid
  confidence              Float?
  candidates              Json
  rationale               String
  unresolvedReason        String?
  createdAt               DateTime             @default(now())
  associationRun          ReidAssociationRun   @relation(fields: [associationRunId], references: [id], onDelete: Cascade)
  tracklet                ReidTracklet         @relation(fields: [trackletId], references: [id], onDelete: Restrict)
  selectedPersonCluster   ReidPersonCluster?   @relation(fields: [selectedPersonClusterId], references: [id], onDelete: SetNull)
  selectedRosterEntry     MatchRosterEntry?    @relation(fields: [selectedRosterEntryId], references: [id], onDelete: SetNull)

  @@unique([associationRunId, trackletId])
  @@index([trackletId, createdAt])
  @@index([selectedPersonClusterId])
}

model ReidIdentityCorrection {
  id                    String                         @id @default(uuid()) @db.Uuid
  matchId               String                         @db.Uuid
  teamId                String?                        @db.Uuid
  analysisRunId         String                         @db.Uuid
  trackletId            String                         @db.Uuid
  sourcePersonClusterId String?                        @db.Uuid
  targetPersonClusterId String?                        @db.Uuid
  rosterEntryId         String?                        @db.Uuid
  displayScope          ReidCorrectionDisplayScope
  futureEvidenceAction  ReidFutureEvidenceAction
  revision              BigInt
  reason                String?
  createdByUserId       String                         @db.Uuid
  createdAt             DateTime                       @default(now())
  match                 Match                          @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team                  Team?                          @relation(fields: [teamId], references: [id], onDelete: Restrict)
  analysisRun           AnalysisRun                    @relation(fields: [analysisRunId], references: [id], onDelete: Restrict)
  tracklet              ReidTracklet                   @relation(fields: [trackletId], references: [id], onDelete: Restrict)
  sourcePersonCluster   ReidPersonCluster?             @relation("ReidIdentityCorrectionSourceCluster", fields: [sourcePersonClusterId], references: [id], onDelete: SetNull)
  targetPersonCluster   ReidPersonCluster?             @relation("ReidIdentityCorrectionTargetCluster", fields: [targetPersonClusterId], references: [id], onDelete: SetNull)
  rosterEntry           MatchRosterEntry?              @relation(fields: [rosterEntryId], references: [id], onDelete: SetNull)
  createdBy             User                           @relation("ReidIdentityCorrectionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  memberships           ReidEvidenceMembership[]
  assignmentRevisions   ReidAssignmentRevision[]
  gidBindingRevisions   ReidGidRosterBindingRevision[]

  @@unique([matchId, revision])
  @@index([analysisRunId, trackletId])
  @@index([targetPersonClusterId])
}

model ReidAssignmentRevision {
  id                        String                   @id @default(uuid()) @db.Uuid
  matchId                   String                   @db.Uuid
  analysisRunId             String                   @db.Uuid
  trackletId                String                   @db.Uuid
  personClusterId           String?                  @db.Uuid
  rosterEntryId             String?                  @db.Uuid
  correctionId              String?                  @db.Uuid
  source                    IdentitySource
  sourcePriority            Int
  revision                  BigInt
  effectiveFromSetNumber    Int
  effectiveFromRallyOrdinal Int
  supersedesRevisionId      String?                  @db.Uuid
  createdByUserId           String?                  @db.Uuid
  createdAt                 DateTime                 @default(now())
  match                     Match                    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  analysisRun               AnalysisRun              @relation(fields: [analysisRunId], references: [id], onDelete: Restrict)
  tracklet                  ReidTracklet             @relation(fields: [trackletId], references: [id], onDelete: Restrict)
  personCluster             ReidPersonCluster?       @relation(fields: [personClusterId], references: [id], onDelete: SetNull)
  rosterEntry               MatchRosterEntry?        @relation(fields: [rosterEntryId], references: [id], onDelete: SetNull)
  correction                ReidIdentityCorrection?  @relation(fields: [correctionId], references: [id], onDelete: Restrict)
  supersedesRevision        ReidAssignmentRevision?  @relation("ReidAssignmentRevisionChain", fields: [supersedesRevisionId], references: [id], onDelete: Restrict)
  supersededByRevisions     ReidAssignmentRevision[] @relation("ReidAssignmentRevisionChain")
  createdBy                 User?                    @relation("ReidAssignmentRevisionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  activeProjection          ReidActiveProjection?

  @@unique([matchId, revision])
  @@index([analysisRunId, trackletId, revision])
  @@index([supersedesRevisionId])
}

model ReidActiveProjection {
  analysisRunId        String                 @db.Uuid
  trackletId           String                 @unique @db.Uuid
  assignmentRevisionId String                 @unique @db.Uuid
  sourcePriority       Int
  updatedAt            DateTime               @updatedAt
  analysisRun          AnalysisRun            @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
  tracklet             ReidTracklet           @relation(fields: [trackletId], references: [id], onDelete: Cascade)
  assignmentRevision   ReidAssignmentRevision @relation(fields: [assignmentRevisionId], references: [id], onDelete: Restrict)

  @@id([analysisRunId, trackletId])
  @@index([analysisRunId, sourcePriority])
}

model ReidIdentityPreview {
  id              String        @id @default(uuid()) @db.Uuid
  trackletId      String        @db.Uuid
  providerJobId   String?       @unique @db.Uuid
  recipeNamespace String
  mediaAssetId    String?       @db.Uuid
  startFrameIndex BigInt
  endFrameIndex   BigInt
  frameCount      Int
  contentSha256   String?
  status          ArtifactState @default(UPLOADING)
  createdAt       DateTime      @default(now())
  readyAt         DateTime?
  tracklet        ReidTracklet  @relation(fields: [trackletId], references: [id], onDelete: Cascade)
  providerJob     ProviderJob?  @relation("ReidPreviewProviderJob", fields: [providerJobId], references: [id], onDelete: Restrict)
  mediaAsset      MediaAsset?   @relation("ReidPreviewAsset", fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@unique([trackletId, recipeNamespace])
  @@index([status, createdAt])
  @@index([mediaAssetId])
}
