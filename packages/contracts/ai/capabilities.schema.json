{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OWNER/volleyball-monitoring-ai/packages/contracts/ai/capabilities/2.0.0",
  "title": "AI Provider Capabilities 2.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider_name",
    "provider_build_id",
    "supported_job_schema_versions",
    "supported_analysis_data_versions",
    "supported_analysis_modules",
    "supports_selective_rerun",
    "optional_extensions",
    "action_taxonomies"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "provider_name": {
      "type": "string",
      "minLength": 1
    },
    "provider_build_id": {
      "type": "string",
      "minLength": 1
    },
    "supported_job_schema_versions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "supported_analysis_data_versions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "supported_analysis_modules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["court", "tracking", "reid", "contacts"]
      }
    },
    "supports_selective_rerun": { "type": "boolean" },
    "optional_extensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "group_phase", "confidence"],
      "properties": {
        "action": {
          "type": "boolean"
        },
        "group_phase": {
          "type": "boolean"
        },
        "confidence": {
          "type": "boolean"
        },
        "fixed_roster_reid": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "action_taxonomies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["taxonomy_id", "taxonomy_version"],
        "properties": {
          "taxonomy_id": {
            "type": "string",
            "minLength": 1
          },
          "taxonomy_version": {
            "type": "string",
            "minLength": 1
          },
          "labels_url": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_clip_bytes": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "max_clip_duration_us": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "max_concurrent_jobs": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
