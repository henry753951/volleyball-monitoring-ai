{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OWNER/volleyball-monitoring-ai/packages/contracts/ai/reid-jersey-vlm-response/1.0.0",
  "title": "ReID Jersey VLM Raw Response Bundle 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider_job_id",
    "evidence_set_id",
    "responses",
    "content_sha256"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "provider_job_id": { "$ref": "#/$defs/id" },
    "evidence_set_id": { "$ref": "#/$defs/id" },
    "responses": {
      "type": "array",
      "items": { "$ref": "#/$defs/response" }
    },
    "content_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "uint64": { "type": "string", "pattern": "^[0-9]+$" },
    "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "response_key",
        "tracklet_id",
        "model_namespace",
        "prompt_sha256",
        "selected_frame_indices",
        "raw_response",
        "raw_response_sha256",
        "candidate_numbers",
        "abstained"
      ],
      "properties": {
        "response_key": { "$ref": "#/$defs/id" },
        "tracklet_id": { "$ref": "#/$defs/id" },
        "model_namespace": { "$ref": "#/$defs/id" },
        "prompt_sha256": { "$ref": "#/$defs/sha256" },
        "selected_frame_indices": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/uint64" }
        },
        "raw_response": { "type": "string", "maxLength": 262144 },
        "raw_response_sha256": { "$ref": "#/$defs/sha256" },
        "candidate_numbers": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0, "maximum": 99 }
        },
        "abstained": { "type": "boolean" },
        "reason": {
          "oneOf": [{ "type": "string", "minLength": 1, "maxLength": 1000 }, { "type": "null" }]
        }
      }
    }
  }
}
