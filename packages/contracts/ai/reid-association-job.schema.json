{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OWNER/volleyball-monitoring-ai/packages/contracts/ai/reid-association-job/1.1.0",
  "title": "ReID Association Job 1.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider_job_id",
    "association_run_id",
    "match_id",
    "evidence_set_id",
    "eligible_tracklet_ids",
    "evidence_result_artifact_id",
    "bank_snapshot_id",
    "bank_snapshot_artifact_id",
    "roster_snapshot_artifact_id",
    "recipe"
  ],
  "properties": {
    "schema_version": { "const": "1.1.0" },
    "provider_job_id": { "$ref": "#/$defs/id" },
    "association_run_id": { "$ref": "#/$defs/id" },
    "match_id": { "$ref": "#/$defs/id" },
    "evidence_set_id": { "$ref": "#/$defs/id" },
    "eligible_tracklet_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "evidence_result_artifact_id": { "$ref": "#/$defs/id" },
    "bank_snapshot_id": { "$ref": "#/$defs/id" },
    "bank_snapshot_artifact_id": { "$ref": "#/$defs/id" },
    "roster_snapshot_artifact_id": { "$ref": "#/$defs/id" },
    "recipe": { "$ref": "#/$defs/recipe" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "candidate_modalities",
        "same_clip_grouping",
        "allow_abstention",
        "manual_assignment_precedence"
      ],
      "properties": {
        "namespace": { "$ref": "#/$defs/id" },
        "candidate_modalities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["DINO", "OSNET", "KPR", "KPR_PROMPT", "JERSEY_VLM"] }
        },
        "same_clip_grouping": { "type": "boolean" },
        "allow_abstention": { "const": true },
        "manual_assignment_precedence": { "const": true }
      }
    }
  }
}
