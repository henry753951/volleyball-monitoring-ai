{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OWNER/volleyball-monitoring-ai/packages/contracts/ai/reid-association-job/2.0.0",
  "title": "ReID Association Job 2.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider_job_id",
    "association_run_id",
    "match_id",
    "evidence_set_id",
    "eligible_tracklet_ids",
    "evidence_result_artifact_id",
    "bank_snapshot_id",
    "bank_snapshot_artifact_id",
    "roster_snapshot_artifact_id",
    "recipe"
  ],
  "properties": {
    "schema_version": { "const": "2.0.0" },
    "provider_job_id": { "$ref": "#/$defs/id" },
    "association_run_id": { "$ref": "#/$defs/id" },
    "match_id": { "$ref": "#/$defs/id" },
    "evidence_set_id": { "$ref": "#/$defs/id" },
    "eligible_tracklet_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "evidence_result_artifact_id": { "$ref": "#/$defs/id" },
    "bank_snapshot_id": { "$ref": "#/$defs/id" },
    "bank_snapshot_artifact_id": { "$ref": "#/$defs/id" },
    "roster_snapshot_artifact_id": { "$ref": "#/$defs/id" },
    "recipe": { "$ref": "#/$defs/recipe" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "candidate_modalities",
        "same_clip_grouping",
        "allow_new_gid",
        "manual_assignment_precedence",
        "team_occupancy_prior"
      ],
      "properties": {
        "namespace": { "$ref": "#/$defs/id" },
        "candidate_modalities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["DINO", "OSNET", "KPR", "KPR_PROMPT"] }
        },
        "same_clip_grouping": { "type": "boolean" },
        "allow_new_gid": { "const": true },
        "manual_assignment_precedence": { "const": true },
        "team_occupancy_prior": {
          "type": "object",
          "additionalProperties": false,
          "required": ["expected_count", "enforcement"],
          "properties": {
            "expected_count": { "type": "integer", "minimum": 1, "maximum": 12 },
            "enforcement": { "const": "SOFT" }
          }
        }
      }
    }
  }
}
