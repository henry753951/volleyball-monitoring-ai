{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OWNER/volleyball-monitoring-ai/packages/contracts/ai/provider-capabilities/3.0.0",
  "title": "Provider Work Capabilities 3.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "provider_name", "provider_build_id", "work_capabilities"],
  "properties": {
    "schema_version": { "const": "3.0.0" },
    "provider_name": { "$ref": "#/$defs/id" },
    "provider_build_id": { "$ref": "#/$defs/id" },
    "work_capabilities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/workCapability" }
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "workKind": {
      "enum": [
        "ANALYSIS",
        "REID_FEATURE_EXTRACTION",
        "REID_ASSOCIATION",
        "PERSON_POSE_EVIDENCE_REBUILD",
        "IDENTITY_PREVIEW_GENERATION"
      ]
    },
    "versions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 32 }
    },
    "strings": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 256 }
    },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accelerator"],
      "properties": {
        "accelerator": { "enum": ["CPU", "CUDA", "MPS", "ANY"] },
        "minimum_memory_bytes": { "$ref": "#/$defs/uint64" }
      }
    },
    "workCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_kind",
        "request_schema_versions",
        "result_schema_versions",
        "accepted_input_artifact_kinds",
        "produced_artifact_kinds",
        "model_recipe_namespaces",
        "hardware",
        "max_concurrency"
      ],
      "properties": {
        "work_kind": { "$ref": "#/$defs/workKind" },
        "request_schema_versions": { "$ref": "#/$defs/versions" },
        "result_schema_versions": { "$ref": "#/$defs/versions" },
        "accepted_input_artifact_kinds": { "$ref": "#/$defs/strings" },
        "produced_artifact_kinds": { "$ref": "#/$defs/strings" },
        "model_recipe_namespaces": { "$ref": "#/$defs/strings" },
        "hardware": { "$ref": "#/$defs/hardware" },
        "max_concurrency": { "type": "integer", "minimum": 1, "maximum": 64 }
      }
    },
    "uint64": { "type": "string", "pattern": "^[0-9]+$" }
  }
}
