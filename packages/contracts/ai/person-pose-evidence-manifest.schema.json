{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OWNER/volleyball-monitoring-ai/packages/contracts/ai/person-pose-evidence-manifest/1.0.0",
  "title": "Person Pose Evidence Manifest 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analysis_run_id",
    "clip_asset_id",
    "canonical_frame_count",
    "player_observation_count",
    "pose_observation_count",
    "missing_observation_count",
    "pose_recipe",
    "chunks",
    "content_sha256"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "analysis_run_id": { "$ref": "#/$defs/id" },
    "clip_asset_id": { "$ref": "#/$defs/id" },
    "canonical_frame_count": { "$ref": "#/$defs/uint64" },
    "player_observation_count": { "$ref": "#/$defs/uint64" },
    "pose_observation_count": { "$ref": "#/$defs/uint64" },
    "missing_observation_count": { "$ref": "#/$defs/uint64" },
    "pose_recipe": { "$ref": "#/$defs/recipe" },
    "chunks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/chunk" }
    },
    "content_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "uint64": { "type": "string", "pattern": "^[0-9]+$" },
    "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "model_name",
        "checkpoint_sha256",
        "preprocess_version",
        "keypoint_layout",
        "coordinate_space"
      ],
      "properties": {
        "namespace": { "$ref": "#/$defs/id" },
        "model_name": { "$ref": "#/$defs/id" },
        "checkpoint_sha256": { "$ref": "#/$defs/sha256" },
        "preprocess_version": { "$ref": "#/$defs/id" },
        "keypoint_layout": { "const": "COCO_17" },
        "coordinate_space": { "const": "NORMALIZED_VIDEO" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "kind",
        "schema_version",
        "sha256",
        "byte_length",
        "content_type"
      ],
      "properties": {
        "artifact_id": { "$ref": "#/$defs/id" },
        "kind": { "const": "PERSON_POSE_EVIDENCE_CHUNK" },
        "schema_version": { "const": "1.0.0" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byte_length": { "$ref": "#/$defs/uint64" },
        "content_type": {
          "const": "application/vnd.volleyball.person-pose-evidence+flatbuffers;version=1"
        }
      }
    },
    "chunk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "start_frame_index",
        "end_frame_index",
        "player_observation_count",
        "pose_observation_count",
        "missing_observation_count",
        "artifact"
      ],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "start_frame_index": { "$ref": "#/$defs/uint64" },
        "end_frame_index": { "$ref": "#/$defs/uint64" },
        "player_observation_count": { "$ref": "#/$defs/uint64" },
        "pose_observation_count": { "$ref": "#/$defs/uint64" },
        "missing_observation_count": { "$ref": "#/$defs/uint64" },
        "artifact": { "$ref": "#/$defs/artifact" }
      }
    }
  }
}
