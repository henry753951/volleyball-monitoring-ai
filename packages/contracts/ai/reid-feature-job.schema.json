{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OWNER/volleyball-monitoring-ai/packages/contracts/ai/reid-feature-job/2.0.0",
  "title": "ReID Feature Extraction Job 2.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider_job_id",
    "evidence_set_id",
    "analysis_run_id",
    "match_id",
    "analysis_evidence_artifact_id",
    "roster_snapshot_artifact_id",
    "pose_recipe_namespace",
    "frame_selection_recipe_version",
    "requested_recipes"
  ],
  "properties": {
    "schema_version": { "const": "2.0.0" },
    "provider_job_id": { "$ref": "#/$defs/id" },
    "evidence_set_id": { "$ref": "#/$defs/id" },
    "analysis_run_id": { "$ref": "#/$defs/id" },
    "match_id": { "$ref": "#/$defs/id" },
    "analysis_evidence_artifact_id": { "$ref": "#/$defs/id" },
    "roster_snapshot_artifact_id": { "$ref": "#/$defs/id" },
    "pose_recipe_namespace": { "$ref": "#/$defs/id" },
    "frame_selection_recipe_version": { "$ref": "#/$defs/id" },
    "requested_recipes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/recipe" }
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "modality": { "enum": ["DINO", "OSNET", "KPR", "KPR_PROMPT"] },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modality", "model_namespace"],
      "properties": {
        "modality": { "$ref": "#/$defs/modality" },
        "model_namespace": { "$ref": "#/$defs/id" }
      }
    }
  }
}
