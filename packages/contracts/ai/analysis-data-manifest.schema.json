{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OWNER/volleyball-monitoring-ai/packages/contracts/ai/analysis-data-manifest/1.0.0",
  "title": "Browser AnalysisData Manifest 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analysis_id",
    "analysis_data_version",
    "video",
    "chunk_frame_count",
    "chunks"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "analysis_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "analysis_data_version": {
      "type": "string",
      "minLength": 1
    },
    "video": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "fps",
        "total_frames"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "fps": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "num",
            "den"
          ],
          "properties": {
            "num": {
              "type": "integer",
              "minimum": 1
            },
            "den": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "total_frames": {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      }
    },
    "chunk_frame_count": {
      "type": "integer",
      "minimum": 1
    },
    "chunks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "chunk_index",
          "start_frame_index",
          "frame_count",
          "url",
          "byte_length",
          "sha256"
        ],
        "properties": {
          "chunk_index": {
            "type": "integer",
            "minimum": 0
          },
          "start_frame_index": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "frame_count": {
            "type": "integer",
            "minimum": 1
          },
          "url": {
            "type": "string",
            "format": "uri-reference"
          },
          "byte_length": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$"
          }
        }
      }
    },
    "action_taxonomy": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    }
  }
}
