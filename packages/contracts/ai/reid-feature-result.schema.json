{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OWNER/volleyball-monitoring-ai/packages/contracts/ai/reid-feature-result/2.0.0",
  "title": "ReID Feature Extraction Result 2.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider_job_id",
    "evidence_set_id",
    "analysis_run_id",
    "match_id",
    "status",
    "descriptor_artifact",
    "tracklets",
    "unavailable_evidence",
    "content_sha256"
  ],
  "properties": {
    "schema_version": { "const": "2.0.0" },
    "provider_job_id": { "$ref": "#/$defs/id" },
    "evidence_set_id": { "$ref": "#/$defs/id" },
    "analysis_run_id": { "$ref": "#/$defs/id" },
    "match_id": { "$ref": "#/$defs/id" },
    "status": { "enum": ["READY", "PARTIAL"] },
    "descriptor_artifact": { "$ref": "#/$defs/artifact" },
    "tracklets": { "type": "array", "items": { "$ref": "#/$defs/tracklet" } },
    "unavailable_evidence": { "type": "array", "items": { "$ref": "#/$defs/unavailable" } },
    "content_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "uint64": { "type": "string", "pattern": "^[0-9]+$" },
    "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "modality": { "enum": ["DINO", "OSNET", "KPR", "KPR_PROMPT"] },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "kind",
        "schema_version",
        "sha256",
        "byte_length",
        "content_type"
      ],
      "properties": {
        "artifact_id": { "$ref": "#/$defs/id" },
        "kind": { "const": "REID_DESCRIPTOR_BUNDLE" },
        "schema_version": { "const": "1.0.0" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byte_length": { "$ref": "#/$defs/uint64" },
        "content_type": {
          "const": "application/vnd.volleyball.reid-descriptors+octet-stream;version=1"
        }
      }
    },
    "vector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vector_id",
        "modality",
        "model_namespace",
        "dimension",
        "normalization",
        "distance",
        "byte_offset",
        "byte_length",
        "sha256",
        "source_frame_indices"
      ],
      "properties": {
        "vector_id": { "$ref": "#/$defs/id" },
        "modality": { "$ref": "#/$defs/modality" },
        "model_namespace": { "$ref": "#/$defs/id" },
        "dimension": { "type": "integer", "minimum": 1, "maximum": 65536 },
        "normalization": { "enum": ["NONE", "L2"] },
        "distance": { "enum": ["COSINE", "EUCLIDEAN"] },
        "byte_offset": { "$ref": "#/$defs/uint64" },
        "byte_length": { "$ref": "#/$defs/uint64" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "source_frame_indices": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/uint64" }
        }
      }
    },
    "tracklet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tracklet_id",
        "canonical_track_id",
        "track_id_aliases",
        "court_side",
        "first_frame_index",
        "last_frame_index",
        "cannot_link_tracklet_ids",
        "vectors"
      ],
      "properties": {
        "tracklet_id": { "$ref": "#/$defs/id" },
        "canonical_track_id": { "type": "integer", "minimum": 0 },
        "track_id_aliases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0 }
        },
        "court_side": { "enum": ["LEFT", "RIGHT", "UNKNOWN"] },
        "first_frame_index": { "$ref": "#/$defs/uint64" },
        "last_frame_index": { "$ref": "#/$defs/uint64" },
        "cannot_link_tracklet_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "vectors": { "type": "array", "items": { "$ref": "#/$defs/vector" } }
      }
    },
    "unavailable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tracklet_id", "modality", "reason_code", "message"],
      "properties": {
        "tracklet_id": { "$ref": "#/$defs/id" },
        "modality": { "$ref": "#/$defs/modality" },
        "reason_code": { "$ref": "#/$defs/id" },
        "message": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    }
  }
}
