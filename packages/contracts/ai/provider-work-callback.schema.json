{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OWNER/volleyball-monitoring-ai/packages/contracts/ai/provider-work-callback/1.0.0",
  "title": "Provider Work Callback 1.0.0",
  "oneOf": [
    { "$ref": "#/$defs/processing" },
    { "$ref": "#/$defs/failed" },
    { "$ref": "#/$defs/completed" }
  ],
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "uint64": { "type": "string", "pattern": "^[0-9]+$" },
    "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "workKind": {
      "enum": [
        "ANALYSIS",
        "REID_FEATURE_EXTRACTION",
        "REID_ASSOCIATION",
        "PERSON_POSE_EVIDENCE_REBUILD"
      ]
    },
    "base": {
      "type": "object",
      "required": ["schema_version", "callback_id", "provider_job_id", "work_kind", "kind"],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "callback_id": { "$ref": "#/$defs/id" },
        "provider_job_id": { "$ref": "#/$defs/id" },
        "work_kind": { "$ref": "#/$defs/workKind" },
        "kind": { "enum": ["processing", "failed", "completed"] }
      }
    },
    "processing": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "callback_id",
            "provider_job_id",
            "work_kind",
            "kind",
            "progress"
          ],
          "properties": {
            "schema_version": { "const": "1.0.0" },
            "callback_id": { "$ref": "#/$defs/id" },
            "provider_job_id": { "$ref": "#/$defs/id" },
            "work_kind": { "$ref": "#/$defs/workKind" },
            "kind": { "const": "processing" },
            "progress": { "type": "number", "minimum": 0, "maximum": 1 },
            "stage": { "type": ["string", "null"], "maxLength": 256 }
          }
        }
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": { "$ref": "#/$defs/id" },
        "message": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "retryable": { "type": "boolean" },
        "details": { "type": ["object", "null"] }
      }
    },
    "failed": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "callback_id",
            "provider_job_id",
            "work_kind",
            "kind",
            "error"
          ],
          "properties": {
            "schema_version": { "const": "1.0.0" },
            "callback_id": { "$ref": "#/$defs/id" },
            "provider_job_id": { "$ref": "#/$defs/id" },
            "work_kind": { "$ref": "#/$defs/workKind" },
            "kind": { "const": "failed" },
            "error": { "$ref": "#/$defs/error" }
          }
        }
      ]
    },
    "resultArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["part_name", "kind", "schema_version", "sha256", "byte_length", "content_type"],
      "properties": {
        "part_name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
        "kind": { "$ref": "#/$defs/id" },
        "schema_version": { "type": "string", "minLength": 1, "maxLength": 32 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byte_length": { "$ref": "#/$defs/uint64" },
        "content_type": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "completed": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "callback_id",
            "provider_job_id",
            "work_kind",
            "kind",
            "result_schema_version",
            "artifacts"
          ],
          "properties": {
            "schema_version": { "const": "1.0.0" },
            "callback_id": { "$ref": "#/$defs/id" },
            "provider_job_id": { "$ref": "#/$defs/id" },
            "work_kind": { "$ref": "#/$defs/workKind" },
            "kind": { "const": "completed" },
            "result_schema_version": { "type": "string", "minLength": 1, "maxLength": 32 },
            "artifacts": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/resultArtifact" }
            }
          }
        }
      ]
    }
  }
}
