{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OWNER/volleyball-monitoring-ai/packages/contracts/ai/job-accepted/1.0.0",
  "title": "AI Job Accepted 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ai_job_id",
    "provider_job_id",
    "state",
    "accepted_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "ai_job_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "provider_job_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "state": {
      "const": "accepted"
    },
    "accepted_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
