{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OWNER/volleyball-monitoring-ai/packages/contracts/annotation/realtime/3.0.0",
  "title": "Annotation Realtime Protocol 3.0.0",
  "description": "3.0.0 separates canonical START/END Rally boundaries from optional manual CONTACT key points. Legacy 2.x commands remain readable during migration.",
  "allOf": [
    {
      "if": { "required": ["command_id"] },
      "then": { "properties": { "command_id": { "$ref": "#/$defs/uuid" } } }
    },
    {
      "if": { "required": ["rally_id"] },
      "then": { "properties": { "rally_id": { "$ref": "#/$defs/uuid" } } }
    }
  ],
  "oneOf": [
    { "$ref": "#/$defs/start_rally_command" },
    { "$ref": "#/$defs/end_rally_command" },
    { "$ref": "#/$defs/set_rally_outcome_command" },
    { "$ref": "#/$defs/create_service_command" },
    { "$ref": "#/$defs/create_contact_command" },
    { "$ref": "#/$defs/close_rally_command" },
    { "$ref": "#/$defs/move_key_point_command" },
    { "$ref": "#/$defs/delete_key_point_command" },
    { "$ref": "#/$defs/reopen_rally_command" },
    { "$ref": "#/$defs/void_rally_command" },
    { "$ref": "#/$defs/submit_rally_command" },
    { "$ref": "#/$defs/soft_lock_intent" },
    { "$ref": "#/$defs/connection_ready" },
    { "$ref": "#/$defs/command_ack" },
    { "$ref": "#/$defs/command_rejected" },
    { "$ref": "#/$defs/rally_snapshot" },
    { "$ref": "#/$defs/presence_snapshot" },
    { "$ref": "#/$defs/rally_processing_update" }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "canonical_room_id": {
      "type": "string",
      "pattern": "^match:[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}:capture:[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
    },
    "decimal_string": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "annotation_status": {
      "enum": ["open", "ready", "submitted", "voided"]
    },
    "score_resolution": {
      "enum": ["pending", "resolved", "unknown"]
    },
    "scoring_court_side": {
      "oneOf": [{ "enum": ["left", "right"] }, { "type": "null" }]
    },
    "resolved_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score_resolution", "scoring_court_side"],
      "properties": {
        "score_resolution": { "const": "resolved" },
        "scoring_court_side": { "enum": ["left", "right"] }
      }
    },
    "unknown_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score_resolution", "scoring_court_side"],
      "properties": {
        "score_resolution": { "const": "unknown" },
        "scoring_court_side": { "type": "null" }
      }
    },
    "outcome": {
      "oneOf": [{ "$ref": "#/$defs/resolved_outcome" }, { "$ref": "#/$defs/unknown_outcome" }]
    },
    "playback_cursor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "playback_window_id",
        "mapping_version",
        "player_media_time_us",
        "observation_source",
        "seek_generation",
        "cursor_status"
      ],
      "properties": {
        "playback_window_id": { "$ref": "#/$defs/identifier" },
        "mapping_version": {
          "type": "integer",
          "minimum": 1
        },
        "player_media_time_us": { "$ref": "#/$defs/decimal_string" },
        "observation_source": {
          "enum": ["request_video_frame_callback", "current_time_fallback"]
        },
        "presented_frames": {
          "oneOf": [{ "$ref": "#/$defs/decimal_string" }, { "type": "null" }]
        },
        "seek_generation": {
          "type": "integer",
          "minimum": 0
        },
        "cursor_status": {
          "enum": ["ready", "seeking", "stale", "gap"]
        }
      }
    },
    "start_rally_command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "command_id",
        "room_id",
        "base_revision",
        "rally_id",
        "kind",
        "payload"
      ],
      "properties": {
        "schema_version": { "const": "3.0.0" },
        "command_id": { "$ref": "#/$defs/identifier" },
        "room_id": { "$ref": "#/$defs/canonical_room_id" },
        "base_revision": { "$ref": "#/$defs/decimal_string" },
        "rally_id": { "$ref": "#/$defs/identifier" },
        "kind": { "const": "START_RALLY" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["playback_cursor"],
          "properties": { "playback_cursor": { "$ref": "#/$defs/playback_cursor" } }
        }
      }
    },
    "end_rally_command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "command_id",
        "room_id",
        "base_revision",
        "rally_id",
        "kind",
        "payload"
      ],
      "properties": {
        "schema_version": { "const": "3.0.0" },
        "command_id": { "$ref": "#/$defs/identifier" },
        "room_id": { "$ref": "#/$defs/canonical_room_id" },
        "base_revision": { "$ref": "#/$defs/decimal_string" },
        "rally_id": { "$ref": "#/$defs/identifier" },
        "kind": { "const": "END_RALLY" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["playback_cursor"],
          "properties": { "playback_cursor": { "$ref": "#/$defs/playback_cursor" } }
        }
      }
    },
    "set_rally_outcome_command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "command_id",
        "room_id",
        "base_revision",
        "rally_id",
        "kind",
        "payload"
      ],
      "properties": {
        "schema_version": { "const": "3.0.0" },
        "command_id": { "$ref": "#/$defs/identifier" },
        "room_id": { "$ref": "#/$defs/canonical_room_id" },
        "base_revision": { "$ref": "#/$defs/decimal_string" },
        "rally_id": { "$ref": "#/$defs/identifier" },
        "kind": { "const": "SET_RALLY_OUTCOME" },
        "payload": { "$ref": "#/$defs/outcome" }
      }
    },
    "create_service_command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "command_id",
        "room_id",
        "base_revision",
        "rally_id",
        "kind",
        "payload"
      ],
      "properties": {
        "schema_version": { "const": "2.0.0" },
        "command_id": { "$ref": "#/$defs/identifier" },
        "room_id": { "$ref": "#/$defs/canonical_room_id" },
        "base_revision": { "$ref": "#/$defs/decimal_string" },
        "rally_id": { "$ref": "#/$defs/identifier" },
        "kind": { "const": "CREATE_SERVICE_KEY_POINT" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["playback_cursor"],
          "properties": {
            "playback_cursor": { "$ref": "#/$defs/playback_cursor" }
          }
        }
      }
    },
    "create_contact_command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "command_id",
        "room_id",
        "base_revision",
        "rally_id",
        "kind",
        "payload"
      ],
      "properties": {
        "schema_version": { "enum": ["2.0.0", "3.0.0"] },
        "command_id": { "$ref": "#/$defs/identifier" },
        "room_id": { "$ref": "#/$defs/canonical_room_id" },
        "base_revision": { "$ref": "#/$defs/decimal_string" },
        "rally_id": { "$ref": "#/$defs/identifier" },
        "kind": { "const": "CREATE_CONTACT_KEY_POINT" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["playback_cursor"],
          "properties": {
            "playback_cursor": { "$ref": "#/$defs/playback_cursor" },
            "terminal_outcome": { "const": "unknown" }
          }
        }
      }
    },
    "close_rally_command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "command_id",
        "room_id",
        "base_revision",
        "rally_id",
        "kind",
        "payload"
      ],
      "properties": {
        "schema_version": { "const": "2.0.0" },
        "command_id": { "$ref": "#/$defs/identifier" },
        "room_id": { "$ref": "#/$defs/canonical_room_id" },
        "base_revision": { "$ref": "#/$defs/decimal_string" },
        "rally_id": { "$ref": "#/$defs/identifier" },
        "kind": { "const": "CLOSE_RALLY" },
        "payload": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["target_key_point_id", "score_resolution", "scoring_court_side"],
              "properties": {
                "target_key_point_id": { "$ref": "#/$defs/identifier" },
                "score_resolution": { "const": "resolved" },
                "scoring_court_side": { "enum": ["left", "right"] }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["target_key_point_id", "score_resolution", "scoring_court_side"],
              "properties": {
                "target_key_point_id": { "$ref": "#/$defs/identifier" },
                "score_resolution": { "const": "unknown" },
                "scoring_court_side": { "type": "null" }
              }
            }
          ]
        }
      }
    },
    "move_key_point_command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "command_id",
        "room_id",
        "base_revision",
        "rally_id",
        "kind",
        "payload"
      ],
      "properties": {
        "schema_version": { "enum": ["2.0.0", "3.0.0"] },
        "command_id": { "$ref": "#/$defs/identifier" },
        "room_id": { "$ref": "#/$defs/canonical_room_id" },
        "base_revision": { "$ref": "#/$defs/decimal_string" },
        "rally_id": { "$ref": "#/$defs/identifier" },
        "kind": { "const": "MOVE_KEY_POINT" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["key_point_id", "playback_cursor"],
          "properties": {
            "key_point_id": { "$ref": "#/$defs/identifier" },
            "playback_cursor": { "$ref": "#/$defs/playback_cursor" }
          }
        }
      }
    },
    "delete_key_point_command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "command_id",
        "room_id",
        "base_revision",
        "rally_id",
        "kind",
        "payload"
      ],
      "properties": {
        "schema_version": { "enum": ["2.0.0", "3.0.0"] },
        "command_id": { "$ref": "#/$defs/identifier" },
        "room_id": { "$ref": "#/$defs/canonical_room_id" },
        "base_revision": { "$ref": "#/$defs/decimal_string" },
        "rally_id": { "$ref": "#/$defs/identifier" },
        "kind": { "const": "DELETE_KEY_POINT" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["key_point_id"],
          "properties": {
            "key_point_id": { "$ref": "#/$defs/identifier" }
          }
        }
      }
    },
    "reopen_rally_command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "command_id",
        "room_id",
        "base_revision",
        "rally_id",
        "kind",
        "payload"
      ],
      "properties": {
        "schema_version": { "enum": ["2.0.0", "3.0.0"] },
        "command_id": { "$ref": "#/$defs/identifier" },
        "room_id": { "$ref": "#/$defs/canonical_room_id" },
        "base_revision": { "$ref": "#/$defs/decimal_string" },
        "rally_id": { "$ref": "#/$defs/identifier" },
        "kind": { "const": "REOPEN_RALLY" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "maxProperties": 0
        }
      }
    },
    "void_rally_command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "command_id",
        "room_id",
        "base_revision",
        "rally_id",
        "kind",
        "payload"
      ],
      "properties": {
        "schema_version": { "enum": ["2.0.0", "3.0.0"] },
        "command_id": { "$ref": "#/$defs/identifier" },
        "room_id": { "$ref": "#/$defs/canonical_room_id" },
        "base_revision": { "$ref": "#/$defs/decimal_string" },
        "rally_id": { "$ref": "#/$defs/identifier" },
        "kind": { "const": "VOID_RALLY" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reason"],
          "properties": {
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          }
        }
      }
    },
    "submit_rally_command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "command_id",
        "room_id",
        "base_revision",
        "rally_id",
        "kind",
        "payload"
      ],
      "properties": {
        "schema_version": { "enum": ["2.0.0", "3.0.0"] },
        "command_id": { "$ref": "#/$defs/identifier" },
        "room_id": { "$ref": "#/$defs/canonical_room_id" },
        "base_revision": { "$ref": "#/$defs/decimal_string" },
        "rally_id": { "$ref": "#/$defs/identifier" },
        "kind": { "const": "SUBMIT_RALLY" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "maxProperties": 0
        }
      }
    },
    "soft_lock_intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "type", "room_id", "editing_key_point_id"],
      "properties": {
        "schema_version": { "const": "2.1.0" },
        "type": { "const": "soft_lock_intent" },
        "room_id": { "$ref": "#/$defs/canonical_room_id" },
        "editing_key_point_id": {
          "oneOf": [{ "$ref": "#/$defs/identifier" }, { "type": "null" }]
        }
      }
    },
    "connection_ready": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "type",
        "room_id",
        "server_sequence",
        "authenticated_user_id",
        "device_session_id"
      ],
      "properties": {
        "schema_version": { "const": "2.0.0" },
        "type": { "const": "connection_ready" },
        "room_id": { "$ref": "#/$defs/canonical_room_id" },
        "server_sequence": { "$ref": "#/$defs/decimal_string" },
        "authenticated_user_id": { "$ref": "#/$defs/identifier" },
        "device_session_id": { "$ref": "#/$defs/identifier" }
      }
    },
    "resolved_anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "playback_window_id",
        "capture_session_id",
        "capture_epoch_id",
        "source_pts",
        "source_time_base",
        "capture_time_us",
        "capture_frame_index",
        "resolved_player_media_time_us",
        "mapping_version",
        "timing_precision"
      ],
      "properties": {
        "playback_window_id": { "$ref": "#/$defs/identifier" },
        "capture_session_id": { "$ref": "#/$defs/identifier" },
        "capture_epoch_id": { "$ref": "#/$defs/identifier" },
        "dvr_segment_id": {
          "oneOf": [{ "$ref": "#/$defs/identifier" }, { "type": "null" }]
        },
        "source_pts": {
          "type": "string",
          "pattern": "^-?[0-9]+$"
        },
        "source_time_base": {
          "type": "object",
          "additionalProperties": false,
          "required": ["num", "den"],
          "properties": {
            "num": {
              "type": "integer",
              "minimum": 1
            },
            "den": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "capture_time_us": { "$ref": "#/$defs/decimal_string" },
        "capture_frame_index": { "$ref": "#/$defs/decimal_string" },
        "resolved_player_media_time_us": { "$ref": "#/$defs/decimal_string" },
        "mapping_version": {
          "type": "integer",
          "minimum": 1
        },
        "snap_distance_us": {
          "oneOf": [{ "$ref": "#/$defs/decimal_string" }, { "type": "null" }]
        },
        "timing_precision": {
          "enum": ["frame_exact", "pts_exact", "estimated"]
        }
      }
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "boundary_kind": {
          "oneOf": [{ "enum": ["start", "end"] }, { "type": "null" }]
        },
        "created_key_point_id": {
          "oneOf": [{ "$ref": "#/$defs/identifier" }, { "type": "null" }]
        },
        "terminal_key_point_id": {
          "oneOf": [{ "$ref": "#/$defs/identifier" }, { "type": "null" }]
        },
        "deleted_key_point_id": {
          "oneOf": [{ "$ref": "#/$defs/identifier" }, { "type": "null" }]
        },
        "submission_id": {
          "oneOf": [{ "$ref": "#/$defs/identifier" }, { "type": "null" }]
        },
        "annotation_status": { "$ref": "#/$defs/annotation_status" },
        "score_resolution": { "$ref": "#/$defs/score_resolution" },
        "scoring_court_side": { "$ref": "#/$defs/scoring_court_side" }
      },
      "allOf": [
        {
          "if": {
            "required": ["score_resolution"],
            "properties": {
              "score_resolution": { "const": "resolved" }
            }
          },
          "then": {
            "required": ["scoring_court_side"],
            "properties": {
              "scoring_court_side": { "enum": ["left", "right"] }
            }
          }
        },
        {
          "if": {
            "required": ["score_resolution"],
            "properties": {
              "score_resolution": { "enum": ["pending", "unknown"] }
            }
          },
          "then": {
            "required": ["scoring_court_side"],
            "properties": {
              "scoring_court_side": { "type": "null" }
            }
          }
        }
      ]
    },
    "command_ack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "type",
        "command_id",
        "room_id",
        "rally_id",
        "operation_kind",
        "result_revision",
        "server_sequence",
        "effects"
      ],
      "properties": {
        "schema_version": { "enum": ["2.0.0", "3.0.0"] },
        "type": { "const": "command_ack" },
        "command_id": { "$ref": "#/$defs/identifier" },
        "room_id": { "$ref": "#/$defs/canonical_room_id" },
        "rally_id": { "$ref": "#/$defs/identifier" },
        "operation_kind": {
          "enum": [
            "START_RALLY",
            "END_RALLY",
            "SET_RALLY_OUTCOME",
            "CREATE_SERVICE_KEY_POINT",
            "CREATE_CONTACT_KEY_POINT",
            "CLOSE_RALLY",
            "MOVE_KEY_POINT",
            "DELETE_KEY_POINT",
            "REOPEN_RALLY",
            "VOID_RALLY",
            "SUBMIT_RALLY"
          ]
        },
        "result_revision": { "$ref": "#/$defs/decimal_string" },
        "server_sequence": { "$ref": "#/$defs/decimal_string" },
        "effects": { "$ref": "#/$defs/effects" },
        "resolved_anchor": {
          "oneOf": [{ "$ref": "#/$defs/resolved_anchor" }, { "type": "null" }]
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["operation_kind"],
            "properties": { "operation_kind": { "enum": ["START_RALLY", "END_RALLY"] } }
          },
          "then": {
            "required": ["resolved_anchor"],
            "properties": {
              "resolved_anchor": { "$ref": "#/$defs/resolved_anchor" },
              "effects": {
                "required": ["boundary_kind", "annotation_status"],
                "properties": { "boundary_kind": { "enum": ["start", "end"] } }
              }
            }
          }
        },
        {
          "if": {
            "required": ["operation_kind"],
            "properties": {
              "operation_kind": {
                "enum": ["CREATE_SERVICE_KEY_POINT", "CREATE_CONTACT_KEY_POINT"]
              }
            }
          },
          "then": {
            "required": ["resolved_anchor"],
            "properties": {
              "resolved_anchor": { "$ref": "#/$defs/resolved_anchor" },
              "effects": {
                "required": ["created_key_point_id"],
                "properties": {
                  "created_key_point_id": { "$ref": "#/$defs/identifier" }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation_kind": { "const": "CLOSE_RALLY" }
            }
          },
          "then": {
            "required": ["resolved_anchor"],
            "properties": {
              "resolved_anchor": { "type": "null" },
              "effects": {
                "required": [
                  "terminal_key_point_id",
                  "annotation_status",
                  "score_resolution",
                  "scoring_court_side"
                ],
                "properties": {
                  "terminal_key_point_id": { "$ref": "#/$defs/identifier" },
                  "annotation_status": { "const": "ready" },
                  "score_resolution": { "enum": ["resolved", "unknown"] }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": ["operation_kind"],
            "properties": {
              "operation_kind": { "const": "SUBMIT_RALLY" }
            }
          },
          "then": {
            "required": ["resolved_anchor"],
            "properties": {
              "resolved_anchor": { "type": "null" },
              "effects": {
                "required": ["submission_id", "annotation_status"],
                "properties": {
                  "submission_id": { "$ref": "#/$defs/identifier" },
                  "annotation_status": { "const": "submitted" }
                }
              }
            }
          }
        }
      ]
    },
    "command_rejected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "type",
        "command_id",
        "room_id",
        "rally_id",
        "code",
        "snapshot_refetch_required"
      ],
      "properties": {
        "schema_version": { "enum": ["2.0.0", "3.0.0"] },
        "type": { "const": "command_rejected" },
        "command_id": { "$ref": "#/$defs/identifier" },
        "room_id": { "$ref": "#/$defs/canonical_room_id" },
        "rally_id": { "$ref": "#/$defs/identifier" },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "oneOf": [{ "type": "string" }, { "type": "null" }]
        },
        "expected_revision": {
          "oneOf": [{ "$ref": "#/$defs/decimal_string" }, { "type": "null" }]
        },
        "actual_revision": {
          "oneOf": [{ "$ref": "#/$defs/decimal_string" }, { "type": "null" }]
        },
        "snapshot_refetch_required": { "type": "boolean" }
      }
    },
    "key_point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key_point_id",
        "sequence_index",
        "marker_kind",
        "is_terminal",
        "capture_time_us",
        "capture_frame_index",
        "timing_precision",
        "possible_duplicate"
      ],
      "properties": {
        "key_point_id": { "$ref": "#/$defs/identifier" },
        "sequence_index": {
          "type": "integer",
          "minimum": 0
        },
        "marker_kind": {
          "enum": ["service", "contact"]
        },
        "is_terminal": { "type": "boolean" },
        "capture_time_us": { "$ref": "#/$defs/decimal_string" },
        "capture_frame_index": { "$ref": "#/$defs/decimal_string" },
        "timing_precision": {
          "enum": ["frame_exact", "pts_exact", "estimated"]
        },
        "possible_duplicate": { "type": "boolean" }
      }
    },
    "rally_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "capture_time_us", "capture_frame_index", "timing_precision"],
      "properties": {
        "kind": { "enum": ["start", "end"] },
        "capture_time_us": { "$ref": "#/$defs/decimal_string" },
        "capture_frame_index": { "$ref": "#/$defs/decimal_string" },
        "timing_precision": { "enum": ["frame_exact", "pts_exact", "estimated"] }
      }
    },
    "rally_snapshot_body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "annotation_status",
        "side_assignment_id",
        "score_resolution",
        "scoring_court_side",
        "processing_status",
        "key_points"
      ],
      "properties": {
        "annotation_status": { "$ref": "#/$defs/annotation_status" },
        "side_assignment_id": { "$ref": "#/$defs/identifier" },
        "score_resolution": { "$ref": "#/$defs/score_resolution" },
        "scoring_court_side": { "$ref": "#/$defs/scoring_court_side" },
        "processing_status": {
          "enum": [
            "idle",
            "clip_queued",
            "clipping",
            "ai_queued",
            "ai_processing",
            "artifact_ingesting",
            "completed",
            "failed",
            "superseded"
          ]
        },
        "active_submission_id": {
          "oneOf": [{ "$ref": "#/$defs/identifier" }, { "type": "null" }]
        },
        "key_points": {
          "type": "array",
          "items": { "$ref": "#/$defs/key_point" }
        },
        "boundaries": {
          "type": "array",
          "items": { "$ref": "#/$defs/rally_boundary" },
          "maxItems": 2
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["annotation_status", "active_submission_id"],
            "properties": {
              "annotation_status": { "const": "open" },
              "active_submission_id": { "type": "null" }
            }
          },
          "then": {
            "properties": {
              "score_resolution": { "const": "pending" },
              "scoring_court_side": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "required": ["annotation_status", "active_submission_id"],
            "properties": {
              "annotation_status": { "const": "open" },
              "active_submission_id": { "$ref": "#/$defs/identifier" }
            }
          },
          "then": {
            "properties": {
              "score_resolution": { "enum": ["pending", "resolved", "unknown"] }
            }
          }
        },
        {
          "if": {
            "properties": {
              "annotation_status": { "enum": ["ready", "submitted"] }
            }
          },
          "then": {
            "properties": {
              "score_resolution": { "enum": ["pending", "resolved", "unknown"] }
            }
          }
        },
        {
          "if": {
            "properties": {
              "score_resolution": { "const": "resolved" }
            }
          },
          "then": {
            "properties": {
              "scoring_court_side": { "enum": ["left", "right"] }
            }
          }
        },
        {
          "if": {
            "properties": {
              "score_resolution": { "enum": ["pending", "unknown"] }
            }
          },
          "then": {
            "properties": {
              "scoring_court_side": { "type": "null" }
            }
          }
        }
      ]
    },
    "rally_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "type",
        "room_id",
        "rally_id",
        "revision",
        "server_sequence",
        "snapshot"
      ],
      "properties": {
        "schema_version": { "enum": ["2.0.0", "3.0.0"] },
        "type": { "const": "rally_snapshot" },
        "room_id": { "$ref": "#/$defs/canonical_room_id" },
        "rally_id": { "$ref": "#/$defs/identifier" },
        "revision": { "$ref": "#/$defs/decimal_string" },
        "server_sequence": { "$ref": "#/$defs/decimal_string" },
        "snapshot": { "$ref": "#/$defs/rally_snapshot_body" }
      }
    },
    "presence_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "type", "room_id", "members"],
      "properties": {
        "schema_version": { "const": "2.0.0" },
        "type": { "const": "presence_snapshot" },
        "room_id": { "$ref": "#/$defs/canonical_room_id" },
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["user_id", "device_session_id", "display_name"],
            "properties": {
              "user_id": { "$ref": "#/$defs/identifier" },
              "device_session_id": { "$ref": "#/$defs/identifier" },
              "display_name": { "type": "string" },
              "editing_key_point_id": {
                "oneOf": [{ "$ref": "#/$defs/identifier" }, { "type": "null" }]
              }
            }
          }
        }
      }
    },
    "rally_processing_update": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "type",
        "room_id",
        "rally_id",
        "submission_id",
        "processing_status"
      ],
      "properties": {
        "schema_version": { "const": "2.0.0" },
        "type": { "const": "rally_processing_update" },
        "room_id": { "$ref": "#/$defs/canonical_room_id" },
        "rally_id": { "$ref": "#/$defs/identifier" },
        "submission_id": { "$ref": "#/$defs/identifier" },
        "processing_status": {
          "enum": [
            "idle",
            "clip_queued",
            "clipping",
            "ai_queued",
            "ai_processing",
            "artifact_ingesting",
            "completed",
            "failed",
            "superseded"
          ]
        },
        "ai_job_id": {
          "oneOf": [{ "$ref": "#/$defs/identifier" }, { "type": "null" }]
        },
        "worker_instance_key": {
          "oneOf": [{ "type": "string", "minLength": 1, "maxLength": 128 }, { "type": "null" }]
        },
        "provider_build_id": {
          "oneOf": [{ "type": "string", "minLength": 1, "maxLength": 256 }, { "type": "null" }]
        },
        "progress": {
          "oneOf": [{ "type": "number", "minimum": 0, "maximum": 1 }, { "type": "null" }]
        },
        "stage": {
          "oneOf": [{ "type": "string", "minLength": 1, "maxLength": 128 }, { "type": "null" }]
        },
        "updated_at": {
          "oneOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }]
        },
        "analysis_id": {
          "oneOf": [{ "$ref": "#/$defs/identifier" }, { "type": "null" }]
        },
        "analysis_data_version": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            { "type": "null" }
          ]
        },
        "error": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": true
            },
            { "type": "null" }
          ]
        }
      }
    }
  }
}
