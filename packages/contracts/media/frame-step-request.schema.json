{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OWNER/volleyball-monitoring-ai/packages/contracts/media/frame-step-request/1.1.0",
  "title": "Canonical Frame Step Request 1.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capture_session_id",
    "playback_window_id",
    "mapping_version",
    "capture_frame_index",
    "direction",
    "count"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1.0"
    },
    "capture_session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "playback_window_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "mapping_version": {
      "type": "integer",
      "minimum": 1
    },
    "capture_frame_index": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "direction": {
      "enum": [
        "previous",
        "next"
      ]
    },
    "count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120
    }
  }
}
