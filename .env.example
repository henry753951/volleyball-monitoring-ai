NODE_ENV=development
PORT=4000
WEB_ORIGIN=https://volleyball.lan

# Browser uses same-origin paths behind Traefik. For iPad PWA, use a trusted HTTPS LAN origin.
NUXT_PUBLIC_GRAPHQL_PATH=/graphql
NUXT_PUBLIC_ANNOTATION_WS_PATH=/ws/annotations
NUXT_PUBLIC_REST_BASE_PATH=/api/v1
NUXT_PUBLIC_LIVE_HLS_BASE_PATH=/hls

# Local-only deterministic identity. The server ignores development auth in production.
DEV_AUTH_ENABLED=true
DEV_USER_ID=00000000-0000-4000-8000-000000000001
DEV_USER_ROLE=OPERATOR
DEV_USER_DISPLAY_NAME=Dev Operator

DATABASE_URL=postgresql://volleyball:volleyball@postgres:5432/volleyball?schema=public
POSTGRES_HOST_PORT=5433
REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=volleyball
MINIO_SECRET_KEY=volleyball-dev-secret
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
MINIO_RAW_BUCKET=raw-media
MINIO_DVR_BUCKET=dvr-media
MINIO_RALLY_BUCKET=rally-media
MINIO_ANALYSIS_BUCKET=analysis-artifacts

MEDIAMTX_API_URL=http://mediamtx:9997
MEDIA_SPOOL_DIR=/var/lib/volleyball/media-spool
MEDIA_INDEXER_HOOK_TOKEN=change-me-development-token-32-characters-minimum-0000
MEDIA_INDEXER_HOOK_PORT=4100
MEDIA_INDEXER_HOOK_BIND=0.0.0.0
MEDIA_INDEXER_SCAN_INTERVAL_MS=10000

AI_PROVIDER_CAPABILITIES_URL=http://fake-ai-provider:8080/v1/capabilities
AI_PROVIDER_SUBMIT_URL=http://fake-ai-provider:8080/v1/jobs
AI_PROVIDER_BEARER_TOKEN=replace-me
# Fake provider uses the internal service URL. External providers need a reachable HTTPS base URL.
CALLBACK_PUBLIC_BASE_URL=http://server:4000

DVR_SEGMENT_DURATION_SECONDS=2
DVR_PLAYBACK_WINDOW_BACK_SECONDS=120
DVR_PLAYBACK_WINDOW_FORWARD_SECONDS=180
DVR_CLIENT_MAX_BUFFER_SECONDS=180
DVR_CLIENT_BACK_BUFFER_SECONDS=120
CLIP_PRE_ROLL_SECONDS=5
CLIP_POST_ROLL_SECONDS=10
