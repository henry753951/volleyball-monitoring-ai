NODE_ENV=development
PORT=4000
WEB_ORIGIN=https://volleyball.lan

# Browser uses same-origin paths behind Traefik. For iPad PWA, use a trusted HTTPS LAN origin.
NUXT_PUBLIC_GRAPHQL_PATH=/graphql
NUXT_PUBLIC_ANNOTATION_WS_PATH=/ws/annotations
NUXT_PUBLIC_COACH_WS_PATH=/ws/coach
SERVER_DEV_BIND=0.0.0.0
SERVER_DEV_PORT=4000
NUXT_PUBLIC_REST_BASE_PATH=/api/v1
NUXT_PUBLIC_LIVE_HLS_BASE_PATH=/hls
# Optional public YouTube watch/live URL shown in the coach display.
NUXT_PUBLIC_COACH_EMBED_URL=

# Local-only deterministic identity. The server ignores development auth in production.
DEV_AUTH_ENABLED=true
DEV_USER_ID=00000000-0000-4000-8000-000000000001
DEV_USER_ROLE=OPERATOR
DEV_USER_DISPLAY_NAME=Dev Operator

DATABASE_URL=postgresql://volleyball:volleyball@postgres:5432/volleyball?schema=public
POSTGRES_HOST_PORT=5433
REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=volleyball
MINIO_SECRET_KEY=volleyball-dev-secret
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
MINIO_RAW_BUCKET=raw-media
MINIO_DVR_BUCKET=dvr-media
MINIO_RALLY_BUCKET=rally-media
MINIO_ANALYSIS_BUCKET=analysis-artifacts

MEDIAMTX_API_URL=http://mediamtx:9997
MEDIA_SPOOL_DIR=/var/lib/volleyball/media-spool
MEDIA_INDEXER_HOOK_TOKEN=change-me-development-token-32-characters-minimum-0000
MEDIA_INDEXER_HOOK_PORT=4100
MEDIA_INDEXER_HOOK_BIND=0.0.0.0
MEDIA_INDEXER_SCAN_INTERVAL_MS=10000

# Optional real/simulated YouTube Live relay. It is started only with the youtube-relay profile.
YOUTUBE_SOURCE_URL=
YOUTUBE_INGEST_PATH=youtube/live
YOUTUBE_FORMAT=best[ext=mp4][height<=720][acodec!=none][vcodec!=none]/best[height<=720]

AI_PROVIDER_CAPABILITIES_URL=http://tracking-replay-provider:8080/v1/capabilities
AI_PROVIDER_SUBMIT_URL=http://tracking-replay-provider:8080/v1/jobs
AI_PROVIDER_BEARER_TOKEN=replace-me
# Outbound SDK workers authenticate WSS with this token. If omitted, the integration's env: secret is used.
AI_PROVIDER_WS_TOKEN=replace-with-at-least-32-characters-provider-token
AI_CALLBACK_TOKEN_SECRET=replace-with-at-least-32-characters-dev-secret
# Local recorded-inference replay uses the internal service URL. External providers need a reachable HTTPS base URL.
CALLBACK_PUBLIC_BASE_URL=http://server:4000
# Optional local source override; the default resolves to the sibling Contract Lab repository.
CONTRACT_LAB_HANDOFF_PATH=../../volleyball-ai-contract-lab/ai-team-handoff
CONTRACT_LAB_ROOT=../volleyball-ai-contract-lab
CONTRACT_LAB_DVR_SPOOL_PATH=.data/contract-lab-dvr

DVR_SEGMENT_DURATION_SECONDS=2
DVR_PLAYBACK_WINDOW_BACK_SECONDS=120
DVR_PLAYBACK_WINDOW_FORWARD_SECONDS=180
DVR_CLIENT_MAX_BUFFER_SECONDS=180
DVR_CLIENT_BACK_BUFFER_SECONDS=120
CLIP_PRE_ROLL_SECONDS=3
CLIP_POST_ROLL_SECONDS=3
