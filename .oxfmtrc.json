{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "avoid",
  "endOfLine": "lf",
  "ignorePatterns": [
    ".artifacts/**",
    ".codex-dev/**",
    ".data/**",
    ".nuxt/**",
    ".output/**",
    ".playwright-cli/**",
    "coverage/**",
    "dist/**",
    "node_modules/**",
    "output/**",
    "tmp/**",
    "bun.lock",
    "sdk/uv.lock",
    "SHA256SUMS.txt",
    "CHANGELOG.md",
    "docs/MASTER_IMPLEMENTATION_SPEC.md",
    "docs/SYSTEM_SPEC_V3_2.md",
    "docs/*.aux",
    "docs/*.log",
    "docs/*.pdf",
    "docs/*.tex",
    "docs/*.toc",
    "packages/contracts/fixtures/**",
    "packages/contracts/flatbuffers/generated/**",
    "packages/contracts/graphql/schema.graphql",
    "packages/db/generated/**",
    "packages/db/prisma/migrations/**",
    "web/app/gql/**"
  ],
  "printWidth": 100,
  "proseWrap": "preserve",
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all"
}
